# Copy to `.env` and adjust. Used by Docker Compose and by the Vite build.
# Never commit `.env`.

# --- Website (Vite) -----------------------------------------------------------
# Public URL of the deployed site, ending in "/". For a GitHub project site this is
#   https://<your-user>.github.io/<repo-name>/
# It sets the base path, canonical/Open Graph URLs, sitemap.xml and robots.txt.
# The GitHub Actions workflow fills it in automatically; set it here only for
# local production builds (`npm run build`).
VITE_SITE_URL=http://localhost:5173/

# Optional links on the Contact page.
VITE_REPO_URL=
VITE_CONTACT_EMAIL=

# Set to true if the dev server in Docker doesn't notice file changes (macOS/Windows).
VITE_USE_POLLING=false

# --- Admin API (FastAPI) -----------------------------------------------------
# Largest image upload, in MB.
MAX_UPLOAD_MB=60
# Your user and group id (run `id -u` and `id -g` on Linux), so files the admin
# writes into your checkout stay owned by you.
LOCAL_UID=1000
LOCAL_GID=1000
# Paths default to the repository layout. Override only if you move things:
# SITE_DIR=../frontend/public
# DATA_FILE=../frontend/public/data/nebulae.json
# ORIGINALS_DIR=../media/originals
